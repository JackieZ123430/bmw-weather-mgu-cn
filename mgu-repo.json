{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "exclude": [],
    "mguHmi": ["ID7"],
    "build": {
      "python": "tools/build_unit.py",
      "args": ["{id}", "{version}", "{dir}"],
      "sdk": "oap-sdk",
